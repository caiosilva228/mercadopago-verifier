# ==============================================================================
# MERCADO PAGO VERIFIER - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# URL da Aplicação
NEXT_PUBLIC_APP_URL="https://seu-dominio.com"

# Supabase (Banco de Dados, Auth & Storage)
# NOTA: O schema utilizado no PostgreSQL é 'mercadopago' e o bucket é 'payment-receipts'
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_chave_anon_publica"
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_secreta"

# Mercado Pago Argentina
# Obtenha em: https://www.mercadopago.com.ar/developers
# AVISO: Nunca compartilhe nem exponha este token no frontend!
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx"

# Configuração do Servidor
NODE_ENV="production"
PORT=3000
